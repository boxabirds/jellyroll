{
  "name": "jellyland",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "vite build",
    "preview": "vite preview",
    "stack": "wrangler dev --config worker/wrangler.toml --port 8787",
    "stack:migrate": "wrangler d1 migrations apply jellyroll-scores --local --config worker/wrangler.toml",
    "test:worker": "node --test tests/worker-*.test.ts"
  },
  "dependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.160.1"
  }
}
